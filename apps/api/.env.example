NODE_ENV=development
PORT=4000

# Local dev default — matches docker-compose.yml at the repo root
# (`docker compose up -d` from the repo root starts it).
# For a hosted Postgres later (Neon, Railway, RDS, whatever), just swap
# this for that connection string — the driver (node-postgres) is
# standard Postgres wire protocol, so nothing else needs to change.
DATABASE_URL=postgresql://oreset:oreset@localhost:5434/oreset

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-real-64-char-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-64-char-random-secret

# .oreset.local in dev (paired with /etc/hosts entries — see db/migrations/README.md
# and the Phase 0 plan for the cross-subdomain cookie setup), .oreset.com in prod
COOKIE_DOMAIN=.oreset.local

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://app.oreset.local:3000

STORAGE_PROVIDER=local
# API_PUBLIC_URL is optional — defaults to http://localhost:${PORT} if unset.
# Only set it explicitly if the API is reachable at a different public URL
# than PORT would imply (e.g. behind a reverse proxy).
# API_PUBLIC_URL=

# apps/validation — optional locally; falls back to a lightweight stub if
# unreachable. See apps/validation/README.md to run it.
VALIDATION_SERVICE_URL=http://localhost:8001

# Business/legal policy number this scaffold cannot responsibly invent —
# a clearly-labeled placeholder.
MEDIA_RETENTION_DAYS=90

PAYMENT_PROVIDER=dev-stub
