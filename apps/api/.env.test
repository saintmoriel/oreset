# Used only by `pnpm test` (apps/api/tests/*) — never a real deployment
# target. Points at a separate database (oreset_test) on the same local
# Postgres docker-compose.yml already starts, created and migrated
# automatically by tests/global-setup.ts.
NODE_ENV=test
PORT=4099
DATABASE_URL=postgresql://oreset:oreset@localhost:5434/oreset_test

# Dummy values, fine to commit — not used for any real session, only to
# satisfy config/env.ts's zod validation when service modules import it.
ACCESS_TOKEN_SECRET=test-only-access-token-secret-not-a-real-secret-000
REFRESH_TOKEN_SECRET=test-only-refresh-token-secret-not-a-real-secret-000

COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
STORAGE_PROVIDER=local
